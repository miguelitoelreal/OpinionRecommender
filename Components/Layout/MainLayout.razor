@inherits LayoutComponentBase

<div class="page"> @* This class can be used for overall page structure if needed in app.css *@
    <aside class="sidebar"> @* Changed div to aside for semantic HTML, styled via app.css or specific css *@
        <NavMenu />
    </aside>

    <main class="main-content"> @* Added class for specific styling of main area *@
        @* <div class="top-row px-4">  Removed top-row for a cleaner look with the new theme
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div> *@

        <article class="content container-fluid px-4 py-4"> @* Added py-4 for vertical padding, container-fluid for responsiveness *@
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" class="blazor-error-ui-themed" data-nosnippet> @* Added class for themed error UI *@
    <div class="error-content">
        <div class="error-icon">⚡</div>
        An unhandled error has occurred.
        <a href="." class="reload-button">Reload</a>
        <span class="dismiss-button" @onclick="DismissError">🗙</span>
    </div>
</div>

@code {
    private void DismissError(MouseEventArgs args)
    {
        // This is a basic way to hide the error UI.
        // For a real app, you might want to log this or use a more robust solution.
        // JS interop could be used to directly manipulate the style of 'blazor-error-ui'.
        // For simplicity, this example assumes you might add CSS to hide .blazor-error-ui-themed.hidden
        // and toggle a class here. However, the default Blazor behavior might just remove it.
        // The provided CSS for .blazor-error-boundary in app.css will style this.
    }
}

@page "/recommendation"
@using System.Net.Http.Json
@inject HttpClient Http
@* Link to the specific CSS file *@
<link href="Components/Pages/Recommendation.razor.css" rel="stylesheet" />

<div class="recommendation-container">
    <h3 class="mb-4">Product Recommender</h3>

    <div class="input-group-futuristic">
        <label for="userIdInput">User ID (e.g., U1, U2):</label>
        <input id="userIdInput" class="form-control" @bind="userId" placeholder="Enter User ID" />
        <button class="btn btn-primary" @onclick="Recomendar" disabled="@cargando">
            @if (cargando) {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span> Searching...</span>
            } else {
                <span>Recommend</span>
            }
        </button>
    </div>

    @if (cargando && (recomendaciones == null || recomendaciones.Count == 0) && string.IsNullOrEmpty(error))
    {
        <div class="alert alert-info loading-message mt-3">Searching for recommendations...</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger error-message mt-3">@error</div>
    }

    @if (recomendaciones != null && !cargando && string.IsNullOrEmpty(error))
    {
        @if (recomendaciones.Count == 0)
        {
            @if (!string.IsNullOrWhiteSpace(userId)) // Only show warning if a user ID was actually entered
            {
                <div class="alert alert-warning warning-message mt-3">No recommendations found for this user. Try U1, U2, U3, U4, or U5.</div>
            }
        }
        else
        {
            <h4 class="mt-5 mb-3">Visual Recommendations:</h4>
            <div class="recommendation-grid">
                @foreach (var rec in recomendaciones.OrderByDescending(x => x.Score))
                {
                    <div class="product-card">
                        <div class="product-card-img-container">
                            <img src="@rec.Producto.Imagen" class="product-card-img" alt="@rec.Producto.Nombre" />
                            <div class="product-card-img-overlay"></div>
                        </div>
                        <div class="product-card-body">
                            <h5 class="product-card-title">@rec.Producto.Nombre</h5>
                            @* <p class="product-card-text">Some placeholder description or details about the product could go here.</p> *@
                            <div class="product-card-score">
                                <span class="score-label">Score: </span><span class="score-value">@rec.Score.ToString("F2")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private string? userId;
    private List<RecomendacionDto>? recomendaciones; // Initialize as null to better handle initial state
    private bool cargando = false;
    private string? error;

    public class RecomendacionDto
    {
        public string ProductId { get; set; } = string.Empty;
        public float Score { get; set; }
        public ProductoDto Producto { get; set; } = new();
    }

    public class ProductoDto
    {
        public string ProductId { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public string Imagen { get; set; } = string.Empty;
    }

    private async Task Recomendar()
    {
        error = null;
        // recomendaciones = new(); // Clear previous recommendations immediately for better UX
        cargando = true;
        StateHasChanged(); // Update UI to show loading state

        if (string.IsNullOrWhiteSpace(userId))
        {
            error = "User ID must be entered.";
            cargando = false;
            recomendaciones = null; // Clear recommendations if input is invalid
            StateHasChanged();
            return;
        }

        try
        {
            var url = $"/api/recommendation?userId={userId.ToUpperInvariant()}";
            var result = await Http.GetFromJsonAsync<List<RecomendacionDto>>(url);
            recomendaciones = result ?? new List<RecomendacionDto>();
        }
        catch (Exception ex)
        {
            error = "Could not retrieve recommendations: " + ex.Message;
            recomendaciones = null; // Clear on error
        }
        finally
        {
            cargando = false;
            StateHasChanged(); // Update UI with results or error
        }
    }
}
